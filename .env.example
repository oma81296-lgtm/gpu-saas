# =============================================================================
# VoltGPU — Environment Variables
# Copy this file to .env.local and fill in your credentials.
# =============================================================================

# Public App URL (used for OAuth callbacks and Creem checkout redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand (easy to rename later for production)
NEXT_PUBLIC_BRAND_NAME=VoltGPU
NEXT_PUBLIC_BRAND_TAGLINE=On-Demand Secure NVIDIA GPUs, Billed Per Second

# -----------------------------------------------------------------------------
# Lium.io Wholesale Resell API (SERVER-SIDE ONLY — NEVER expose to browser)
# Create a scoped key (read, rent, manage — NO billing scope) at lium.io
# -----------------------------------------------------------------------------
LIUM_API_KEY=sk_your_lium_api_key_here
LIUM_API_BASE_URL=https://lium.io/api

# -----------------------------------------------------------------------------
# Appwrite (Auth + Database + Functions)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_server_api_key
APPWRITE_DATABASE_ID=voltgpu

# Comma-separated list of admin emails that automatically get admin role on bootstrap
ADMIN_EMAILS=admin@example.com

# -----------------------------------------------------------------------------
# Creem (Merchant of Record — Prepaid Credit Packs)
# Test-mode products already provisioned in your Creem store:
# -----------------------------------------------------------------------------
CREEM_API_KEY=creem_test_your_api_key_here
CREEM_WEBHOOK_SECRET=whsec_your_creem_webhook_secret_here
CREEM_API_BASE_URL=https://test-api.creem.io
CREEM_PRODUCT_10=prod_1VA4LJtHhT5Bb4aKZtXtZ
CREEM_PRODUCT_25=prod_3Iv37cf8hspUXfuxUSIFvS
CREEM_PRODUCT_50=prod_1sarjWBD98STIkb56qWvdp
CREEM_PRODUCT_100=prod_5R8ONictJgbHNiAmtmygh9

# -----------------------------------------------------------------------------
# Optional: Internal cron secret if triggering /api/internal/* from external cron
# -----------------------------------------------------------------------------
INTERNAL_CRON_SECRET=change_me_to_a_long_random_secret

# -----------------------------------------------------------------------------
# MCP OAuth 2.1 Signing Secret (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
MCP_OAUTH_SECRET=change_me_to_a_64_char_random_hex_secret
